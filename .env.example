# Database Configuration
DB_HOST=
DB_NAME=
DB_PARAMS="?sslmode=require"
DB_PASSWORD=
DB_PORT=
DB_USER=

# App Secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
# 10 seconds in ms
JWT_EXPIRATION=1000000
# 15 seconds in ms
JWT_REFRESH_EXPIRATION=1500000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sparkling-email-awad.vercel.app

# Swagger
SWAGGER_SERVER_URL=
SWAGGER_SERVER_DESCRIPTION=

# AI (Google AI Studio / Gemini)
GOOGLE_AI_STUDIO_API_KEY=
AI_PROVIDER=gemini
AI_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=12000
AI_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_ENTRIES=2000
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GEMINI_MAX_OUTPUT_TOKENS=120
AI_GEMINI_TEMPERATURE=0.2