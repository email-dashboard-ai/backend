# Database Configuration
DB_HOST=
DB_NAME=
DB_PARAMS="?sslmode=require"
DB_PASSWORD=
DB_PORT=
DB_USER=

# App Secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=test
# 10 seconds in ms
JWT_EXPIRATION=1000000
# 15 seconds in ms
JWT_REFRESH_EXPIRATION=1500000

# CORS Configuration
CORS_ALLOWED_ORIGINS=

# Swagger
SWAGGER_SERVER_URL=
SWAGGER_SERVER_DESCRIPTION=Local server

# AI Configuration
AI_PROVIDER=groq
AI_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=12000
AI_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_ENTRIES=2000
AI_SUMMARY_PROMPT="You are an email assistant. Summarize the following email in 1-2 concise sentences for a Kanban task card. Focus on: the main action required or key information, who is involved, and any deadlines if mentioned. Ignore greetings, signatures, and promotional content. Be direct and actionable."

# Gemini (Google AI Studio)
GOOGLE_AI_STUDIO_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GEMINI_MAX_OUTPUT_TOKENS=120
AI_GEMINI_TEMPERATURE=0.2

# Groq (Free tier - get key from https://console.groq.com)
GROQ_API_KEY=
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_GROQ_MAX_OUTPUT_TOKENS=120
AI_GROQ_TEMPERATURE=0.2

# Search Config
SYNC_RETENTION_DAYS=45
